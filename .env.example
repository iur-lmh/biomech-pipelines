# =============================================================================
# biomech-pipelines — copiar a .env
# =============================================================================

# Sal HMAC obligatoria para seudonimizar (mínimo 16 caracteres).
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(32))"
BIOMECH_ANON_SALT=dev-only-change-me-32-bytes-minimum

# Desplazamiento determinista de fechas por sujeto (0 = desactivado)
BIOMECH_DATE_SHIFT_DAYS=0

# Directorio por defecto de salidas
BIOMECH_OUTPUT_DIR=datasets

# Tamaño máximo admitido por archivo (MB)
BIOMECH_MAX_FILE_MB=2048
